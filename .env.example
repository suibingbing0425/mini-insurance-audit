# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会入库）
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=insurance_audit
DB_USER=root
DB_PASS=your_mysql_password
# 用 openssl rand -hex 32 生成，至少 32 位随机串
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES=7d
# 允许跨域的前端来源，多个用逗号分隔
CORS_ORIGIN=http://localhost:5173
