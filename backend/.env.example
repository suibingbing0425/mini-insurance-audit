# 复制为 backend/.env 后填写真实值（.env 已被 .gitignore 忽略，不会入库）
# 本地开发：DB_HOST=localhost；Docker 部署：compose 会自动覆盖为 db（容器服务名）
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=insurance_audit
DB_USER=root
DB_PASS=your_mysql_password
# 用 openssl rand -hex 32 生成，至少 32 位随机串（切勿使用示例值）
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES=7d
# 允许跨域的前端来源，多个用逗号分隔（开发 5173；Docker 前端 nginx 8080）
CORS_ORIGIN=http://localhost:5173
